rules_version = '2';

// EvoQuest profile store.
//
// Paste this into Firebase console -> Firestore Database -> Rules -> Publish.
//
// Deliberately conservative. Firestore Security Rules are a tiny declarative
// language, not JavaScript, and they reject a lot of things that look
// perfectly reasonable. Everything here is written as single-return helper
// functions with one expression, because that is the shape the Firebase docs
// themselves use. There is no `is` type operator, no negation of a type check,
// and no loops anywhere.
//
// What this actually protects, given the game runs entirely in the player's
// browser:
//
//   * You may only read and write your own document.
//   * Your counters may only ever go up. That is the one meaningful guard: it
//     stops a client from lowering its own numbers or resetting them.
//
// What it does NOT protect, and cannot without a server: a player can still
// edit its own data in devtools and write an inflated (but plausible) total.
// Since the client owns the document, only a server can verify anything. Do not
// build ranked play or a leaderboard on top of this.

service cloud.firestore {
  match /databases/{database}/documents {

    // You are signed in, and you are you.
    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // No stray fields: a document may only contain what the game writes, which
    // also stops anyone smuggling in extra keys.
    function onlyKnownFields() {
      return request.resource.data.keys().hasOnly([
        'v', 'name', 'rank', 'xp', 'totalXp', 'bestRank',
        'kills', 'deaths', 'food', 'playSec', 'bestTimes', 'updatedAt'
      ]);
    }

    // Keeps the obvious nonsense out: rank must be a real index into the ladder
    // (0-9) and the counters must not be negative. Deliberately no type checks
    // -- see the note at the top of this file.
    function valuesInRange() {
      return request.resource.data.rank >= 0 && request.resource.data.rank <= 9 && request.resource.data.bestRank >= 0 && request.resource.data.bestRank <= 9 && request.resource.data.xp >= 0 && request.resource.data.totalXp >= 0 && request.resource.data.kills >= 0 && request.resource.data.deaths >= 0 && request.resource.data.food >= 0 && request.resource.data.playSec >= 0;
    }

    // Creating your own profile from scratch.
    match /profiles/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && onlyKnownFields()
                    && valuesInRange();

      // Updating: same document, and counters may only increase. `deaths` is
      // included because dying costs XP, not because it is a score.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.totalXp >= resource.data.totalXp
                    && request.resource.data.bestRank >= resource.data.bestRank
                    && request.resource.data.kills >= resource.data.kills
                    && request.resource.data.deaths >= resource.data.deaths
                    && request.resource.data.food >= resource.data.food
                    && request.resource.data.rank >= resource.data.rank;

      allow read: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
